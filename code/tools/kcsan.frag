CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=n
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_SLUB_DEBUG=y
CONFIG_DEBUG_FS=y
CONFIG_FRAME_WARN=0
CONFIG_DEBUG_INFO_NONE=y
CONFIG_KALLSYMS=y
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_DUMMY=y
CONFIG_NET_UDP_TUNNEL=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_RT=y
CONFIG_NFT_EXTHDR=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_CHACHA20=y
CONFIG_CRYPTO_POLY1305=y
# No openssl headers in the build sysroot: drop the certificate machinery.
CONFIG_MODULE_SIG=n
CONFIG_SYSTEM_TRUSTED_KEYRING=n
CONFIG_SYSTEM_REVOCATION_LIST=n
CONFIG_MODULE_SIG_ALL=n
CONFIG_INTEGRITY_ASYMMETRIC_KEYS=n
CONFIG_KEYS=n
# KCSAN (data races) cannot be combined with KASAN, so it has its own kernel. Sample often: the runs are short.
CONFIG_DEBUG_KERNEL=y
CONFIG_KCSAN=y
CONFIG_KCSAN_STRICT=n
CONFIG_KCSAN_REPORT_ONCE_IN_MS=100
CONFIG_KCSAN_SKIP_WATCH=200
CONFIG_KCSAN_UDELAY_TASK=100
CONFIG_KCSAN_UDELAY_INTERRUPT=20
CONFIG_KCSAN_REPORT_VALUE_CHANGE_ONLY=y
CONFIG_VXLAN=y
