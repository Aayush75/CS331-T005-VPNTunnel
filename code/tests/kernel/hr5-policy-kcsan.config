# Separate HR5 strict KCSAN seed; never combine KCSAN and KASAN.
# Starts from the same resolved Linux 6.18 x86-64 HR3 debug base.
CONFIG_LOCALVERSION="-hr5-kcsan"
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_KUNIT=y
# CONFIG_KASAN is not set
CONFIG_KCSAN=y
CONFIG_KCSAN_STRICT=y
CONFIG_UBSAN=y
CONFIG_PROVE_LOCKING=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AEAD=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
