# HR5 seed atop the resolved Linux 6.18 HR3 x86-64 debug configuration.
# The executed full config/image hashes, not this fragment, identify evidence.
CONFIG_LOCALVERSION="-hr5-clang-debug"
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_KUNIT=y
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_UBSAN=y
CONFIG_PROVE_LOCKING=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AEAD=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
